# Optional local configuration. The application does NOT load this file automatically.
# macOS/Linux: copy to .env, then: set -a; source .env; set +a
VLM_BASE_URL=http://localhost:11434/v1
VLM_MODEL=qwen2.5vl:7b
VLM_API_STYLE=ollama
# Local Ollama needs no API key. Only set VLM_API_KEY for a service that requires it.
# VLM_API_KEY=
# Optional dataset directory for label_app.py, containing sources.json and images/.
# RAILREVIEW_LABEL_DATASET=data/my-dataset
